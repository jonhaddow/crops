{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "crops",
	"compatibility_date": "2026-10-03",
	"assets": {
		"binding": "ASSETS"
	},
	"workers_dev": false,
	"routes": [{ "pattern": "crops.app.haddow.me", "custom_domain": true }],
	"observability": {
		"enabled": true
	},
	// Previews are harmless (no server data), but nothing needs them.
	"preview_urls": false
}
